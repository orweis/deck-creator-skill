# Copy to .env (gitignored) and fill in. Never commit real keys.

# Required
OPENAI_API_KEY=sk-your-key-here

# Your "voice": set at least one of the next three.
# Path to the system instructions (absolute, or relative to the repo root).
OPENAI_INSTRUCTIONS_FILE=voice/instructions.md
# Comma-separated vector store IDs used for file_search (your knowledge base).
OPENAI_VECTOR_STORE_IDS=vs_your_vector_store_id
# Optional reusable prompt from the OpenAI dashboard.
# OPENAI_PROMPT_ID=pmpt_your_prompt_id
# OPENAI_PROMPT_VERSION=1

# Optional
# OPENAI_MODEL=gpt-5.5
# OPENAI_RUN_TIMEOUT=300
